:8080 {
	# JSON access logging for log shipper
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}

	# See caddy/Caddyfile: application/x-ndjson must be named explicitly or search
	# results go out uncompressed.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/x-ndjson*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	@ingest path /api/v1/ingest* /_bulk /v1/logs
	@sse path */events */stream

	# Ordered routing so the internal-endpoint 403 wins before the catch-all proxy
	# (a bare `respond` loses to a catch-all `handle {}` outside a route block).
	route {
		# Block external access to internal-only endpoints
		respond /api/v1/internal/* 403

		# High-volume ingest endpoints go to the dedicated ingest tier (skip logging).
		handle @ingest {
			log_skip
			reverse_proxy bifract-ingest:8080
		}

		# SSE endpoints need immediate flushing
		handle @sse {
			reverse_proxy bifract-app:8080 {
				flush_interval -1
			}
		}

		# Everything else -> app tier
		reverse_proxy bifract-app:8080
	}
}

# Ingest-only port for agents and log shippers. Mirrors the prod Caddyfile so the
# isolation this port exists for -- ingest paths only, 403 for everything else --
# is exercised in dev rather than first in production.
:8443 {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 200MiB
	}

	# Only ingest endpoints are allowed on this port
	@ingest path /api/v1/ingest* /_bulk /v1/logs
	handle @ingest {
		reverse_proxy bifract-ingest:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Block everything else
	respond 403
}
