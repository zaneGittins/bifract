{$BIFRACT_DOMAIN:localhost} {
	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Match Bifract max body size
	request_body {
		max_size 200MiB
	}

	# JSON access logging for log shipper
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}

	# Search results are NDJSON of normalized log JSON and compress ~14x (a 250-row
	# page measured 536KB raw, 38KB gzip, 26KB zstd), which on a remote browser is
	# most of the wall time of a search. application/x-ndjson is NOT in Caddy's
	# default match list, so it has to be named explicitly or the results -- the
	# largest response the app serves -- go out uncompressed.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/x-ndjson*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	@ingest path /api/v1/ingest* /_bulk /v1/logs
	@sse path */events */stream

	# Ordered routing so the internal-endpoint 403 wins before the catch-all proxy
	# (a bare `respond` loses to a catch-all `handle {}` outside a route block).
	route {
		# Block external access to internal-only endpoints
		respond /api/v1/internal/* 403

		# Ingest endpoints go to the dedicated ingest tier, even on the main port, so
		# they never load the app/UI tier.
		handle @ingest {
			reverse_proxy bifract-ingest:8080 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
			}
		}

		# SSE endpoints need immediate flushing (no response buffering)
		handle @sse {
			reverse_proxy bifract-app:8080 {
				flush_interval -1
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
			}
		}

		# Everything else -> app tier
		reverse_proxy bifract-app:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# Ingest-only port for agents and log shippers
:8443 {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 200MiB
	}

	# Only ingest endpoints are allowed on this port
	@ingest path /api/v1/ingest* /_bulk /v1/logs
	handle @ingest {
		reverse_proxy bifract-ingest:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Block everything else
	respond 403
}
