/bifract-archiver
/bifract-setup
/cmd/bifract/bifract
/cmd/bifract-server/bifract-server
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Dependencies
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/

# Development-only browser tests. Excluded from the build context so they can
# never enter any image layer, even the builder stage.
node_modules/
test/e2e/
playwright.config.js
package.json
package-lock.json
test-results/
playwright-report/
