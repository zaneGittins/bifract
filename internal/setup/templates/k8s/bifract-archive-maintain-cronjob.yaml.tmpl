apiVersion: batch/v1
kind: CronJob
metadata:
  name: bifract-archive-maintain
  namespace: bifract
  labels:
    app: bifract
    component: archive-maintain
spec:
  # Compaction, snapshot expiry, and orphan-file cleanup for the Iceberg tables.
  # A SINGLETON job (not per-pod): concurrencyPolicy Forbid ensures only one runs
  # at a time so concurrent maintenance never fights over table metadata. It is a
  # no-op unless archiving is enabled and an object-storage backend is configured.
  schedule: "17 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  startingDeadlineSeconds: 300
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 3600
      template:
        metadata:
          labels:
            app: bifract
            component: archive-maintain
        spec:
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            fsGroup: 65534
          containers:
            - name: bifract-archive-maintain
              image: ghcr.io/zanegittins/bifract:{{.ImageTag}}
              command: ["/bifract-archiver", "maintain"]
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities:
                  drop:
                    - ALL
              env:
                - name: POSTGRES_HOST
                  value: "postgres"
                - name: POSTGRES_PORT
                  value: "5432"
                - name: POSTGRES_DB
                  value: "bifract"
                - name: POSTGRES_USER
                  value: "bifract"
                - name: POSTGRES_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: POSTGRES_PASSWORD
                - name: BIFRACT_ARCHIVE_DISK_PATH
                  value: /var/lib/bifract/archive
                - name: BIFRACT_ARCHIVE_ENABLED
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_ENABLED
                      optional: true
                - name: BIFRACT_ARCHIVE_BACKEND
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_BACKEND
                      optional: true
                - name: BIFRACT_ARCHIVE_PREFIX
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_PREFIX
                      optional: true
                - name: BIFRACT_ARCHIVE_S3_ENDPOINT
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_S3_ENDPOINT
                      optional: true
                - name: BIFRACT_ARCHIVE_S3_BUCKET
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_S3_BUCKET
                      optional: true
                - name: BIFRACT_ARCHIVE_S3_REGION
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_S3_REGION
                      optional: true
                - name: BIFRACT_ARCHIVE_S3_ACCESS_KEY
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_S3_ACCESS_KEY
                      optional: true
                - name: BIFRACT_ARCHIVE_S3_SECRET_KEY
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_S3_SECRET_KEY
                      optional: true
                - name: BIFRACT_ARCHIVE_AZURE_ACCOUNT
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_AZURE_ACCOUNT
                      optional: true
                - name: BIFRACT_ARCHIVE_AZURE_KEY
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_AZURE_KEY
                      optional: true
                - name: BIFRACT_ARCHIVE_AZURE_CONTAINER
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_AZURE_CONTAINER
                      optional: true
                - name: BIFRACT_ARCHIVE_AZURE_ENDPOINT
                  valueFrom:
                    secretKeyRef:
                      name: bifract-secrets
                      key: ARCHIVE_AZURE_ENDPOINT
                      optional: true
              volumeMounts:
                - name: tmp
                  mountPath: /tmp
              resources:
                requests:
                  cpu: {{.ArchiverRes.CPURequest}}
                  memory: {{.ArchiverRes.MemRequest}}
                limits:
                  cpu: "{{.ArchiverRes.CPULimit}}"
                  memory: {{.ArchiverRes.MemLimit}}
          volumes:
            - name: tmp
              emptyDir: {}
