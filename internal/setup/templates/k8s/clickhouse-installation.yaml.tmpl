apiVersion: clickhouse.com/v1alpha1
kind: KeeperCluster
metadata:
  name: bifract-keeper
  namespace: bifract
spec:
  replicas: 1
  dataVolumeClaimSpec:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: 10Gi
  containerTemplate:
    image:
      repository: clickhouse/clickhouse-keeper
      tag: "26.6.2.81-alpine"
    resources:
      requests:
        cpu: {{.CHKeeper.CPURequest}}
        memory: {{.CHKeeper.MemRequest}}
      limits:
        cpu: "{{.CHKeeper.CPULimit}}"
        memory: {{.CHKeeper.MemLimit}}
---
apiVersion: clickhouse.com/v1alpha1
kind: ClickHouseCluster
metadata:
  name: bifract-ch
  namespace: bifract
spec:
  shards: {{.CHShards}}
  # Single replica per shard. Durability and disaster recovery are handled by the
  # Apache Iceberg archive, not ClickHouse replication. Keeper is still required to
  # coordinate distributed (ON CLUSTER) DDL and cross-shard queries.
  replicas: 1
  keeperClusterRef:
    name: bifract-keeper
  podTemplate:
    securityContext:
      fsGroupChangePolicy: OnRootMismatch
      runAsUser: 101
      runAsGroup: 101
      fsGroup: 101
      runAsNonRoot: true
    affinity:
      podAntiAffinity:
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app: bifract-ch-clickhouse
              topologyKey: kubernetes.io/hostname
  dataVolumeClaimSpec:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: {{.CHStorageStr}}
  containerTemplate:
    image:
      repository: clickhouse/clickhouse-server
      tag: "26.6.2.81-alpine"
    resources:
      requests:
        cpu: "{{.CH.CPURequest}}"
        memory: {{.CH.MemRequest}}
      limits:
        cpu: "{{.CH.CPULimit}}"
        memory: {{.CH.MemLimit}}
  settings:
    defaultUserPassword:
      passwordType: password_sha256_hex
      secret:
        name: bifract-secrets
        key: CLICKHOUSE_PASSWORD_HASH
    # Workload/resource definitions (the search CPU and memory limits the app
    # provisions with CREATE WORKLOAD) live in Keeper rather than each node's local
    # disk, so every node enforces the same limits and a node added later inherits
    # them instead of running searches unscheduled.
    extraConfig:
      workload_zookeeper_path: /clickhouse/workload/definitions.sql
{{- if .CHMaxServerMemory}}
      # Explicit memory cap + disabled cgroup memory worker. Under a container memory
      # limit, page cache counts toward cgroup usage, and ClickHouse's cgroup observer
      # clamps its own effective memory limit down as cache fills -- starving merges
      # and inserts and, under load, stalling the cluster. An explicit cap (80% of the
      # pod limit, 20% headroom for OS/reclaimable cache) plus memory_worker_use_cgroup=0
      # avoids that.
      #
      # max_bytes_to_merge_at_max_space_in_pool is a fixed, schema-driven value (25%
      # of max_server_memory_usage), not a pod-size ratio: the per-byte memory cost
      # of merging this table (a wide `fields` JSON column plus a dozen-plus skip
      # indexes rebuilt every merge) is a property of the schema, not of how much RAM
      # the pod has. Measured 2026-07-22 against real merge history: merges from ~2GB
      # to ~19.5GB never peaked above ~5.4GB of actual memory, so this cap keeps real
      # headroom while avoiding the query-performance cost of a much smaller cap
      # (more, smaller final parts per partition).
      #
      # merges_mutations_memory_usage_soft_limit caps how much memory ALL concurrent
      # background merges/mutations may use at once -- ClickHouse's own default for
      # this ratio (0.5) is computed against node-wide memory under Kubernetes, not
      # the pod's cgroup limit, so left at its default it doesn't actually throttle
      # concurrency to what the pod can survive: tasks keep starting until they
      # collide with max_server_memory_usage and get killed (MEMORY_LIMIT_EXCEEDED),
      # retrying forever. Anchoring the same 0.5 ratio to max_server_memory_usage
      # instead (rather than leaving it at 0/auto) fixes this.
      #
      # Values are derived from the CH memory limit (see writeK8sManifests).
      max_server_memory_usage: {{.CHMaxServerMemory}}
      memory_worker_use_cgroup: 0
      merges_mutations_memory_usage_soft_limit: {{.CHMergesMutationsMemoryLimit}}
      merge_tree:
        max_bytes_to_merge_at_max_space_in_pool: {{.CHMaxBytesToMerge}}
{{- end}}
    # NOTE: the official ClickHouse operator (clickhouse.com/v1alpha1) defines the
    # `default` user with a SQL `grants:` section (GRANT ALL ON *.* WITH GRANT OPTION).
    # GRANT ALL already includes the ACCESS MANAGEMENT privileges, so `default` can
    # provision the least-privilege ingest user (bifract_ingest) at startup with no
    # extra config. Do NOT add `access_management` to the default user here: ClickHouse
    # rejects mixing access-control settings with grants ("Any other access control
    # settings can't be specified with grants", Code 36/347) and crashes on startup.
    # (Docker has no SQL-grants default user, so it still uses CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1.)
    extraUsersConfig:
      profiles:
        default:
          distributed_background_insert_batch: 1
          distributed_background_insert_split_batch_on_failure: 1
          distributed_background_insert_max_sleep_time_ms: 5000
