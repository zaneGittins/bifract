apiVersion: clickhouse.com/v1alpha1
kind: KeeperCluster
metadata:
  name: bifract-keeper
  namespace: bifract
spec:
  replicas: 1
  dataVolumeClaimSpec:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: 10Gi
  containerTemplate:
    image:
      repository: clickhouse/clickhouse-keeper
      tag: "26.6.1.1193-alpine"
    resources:
      requests:
        cpu: {{.CHKeeper.CPURequest}}
        memory: {{.CHKeeper.MemRequest}}
      limits:
        cpu: "{{.CHKeeper.CPULimit}}"
        memory: {{.CHKeeper.MemLimit}}
---
apiVersion: clickhouse.com/v1alpha1
kind: ClickHouseCluster
metadata:
  name: bifract-ch
  namespace: bifract
spec:
  shards: {{.CHShards}}
  # Single replica per shard. Durability and disaster recovery are handled by the
  # Apache Iceberg archive, not ClickHouse replication. Keeper is still required to
  # coordinate distributed (ON CLUSTER) DDL and cross-shard queries.
  replicas: 1
  keeperClusterRef:
    name: bifract-keeper
  podTemplate:
    securityContext:
      fsGroupChangePolicy: OnRootMismatch
      runAsUser: 101
      runAsGroup: 101
      fsGroup: 101
      runAsNonRoot: true
    affinity:
      podAntiAffinity:
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app: bifract-ch-clickhouse
              topologyKey: kubernetes.io/hostname
  dataVolumeClaimSpec:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: {{.CHStorageStr}}
  containerTemplate:
    image:
      repository: clickhouse/clickhouse-server
      tag: "26.6.1.1193-alpine"
    resources:
      requests:
        cpu: "{{.CH.CPURequest}}"
        memory: {{.CH.MemRequest}}
      limits:
        cpu: "{{.CH.CPULimit}}"
        memory: {{.CH.MemLimit}}
  settings:
    defaultUserPassword:
      passwordType: password_sha256_hex
      secret:
        name: bifract-secrets
        key: CLICKHOUSE_PASSWORD_HASH
{{- if .CHMaxServerMemory}}
    # Explicit memory cap + disabled cgroup memory worker. Under a container memory
    # limit, page cache counts toward cgroup usage, and ClickHouse's cgroup observer
    # clamps its own effective memory limit down as cache fills -- starving merges
    # and inserts and, under load, stalling the cluster. An explicit cap (80% of the
    # pod limit, 20% headroom for OS/reclaimable cache) plus memory_worker_use_cgroup=0
    # avoids that. max_bytes_to_merge_at_max_space_in_pool is capped well below the
    # memory budget because vertical merges of the wide fields JSON column cost O(N)
    # memory; the 150GB default can select a merge too large to complete in RAM.
    # Values are derived from the CH memory limit (see writeK8sManifests).
    extraConfig:
      max_server_memory_usage: {{.CHMaxServerMemory}}
      memory_worker_use_cgroup: 0
      merge_tree:
        max_bytes_to_merge_at_max_space_in_pool: {{.CHMaxBytesToMerge}}
{{- end}}
    extraUsersConfig:
      users:
        # Allow the default (admin) user to run SQL access-control statements so the
        # app can provision the least-privilege ingest user (bifract_ingest) at startup.
        # Docker uses CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 for the same purpose.
        # NOTE: this is the official ClickHouse operator (clickhouse.com/v1alpha1), which
        # renders extraUsersConfig as literal nested YAML -- NOT Altinity's "user/key"
        # slash paths. It must be nested (users.default.access_management), like profiles
        # below; a "default/access_management" key becomes a bogus username with no auth
        # and crashes ClickHouse on startup (Code 36/347).
        default:
          access_management: 1
      profiles:
        default:
          distributed_background_insert_batch: 1
          distributed_background_insert_split_batch_on_failure: 1
          distributed_background_insert_max_sleep_time_ms: 5000
