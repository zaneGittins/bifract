apiVersion: apps/v1
kind: Deployment
metadata:
  name: litellm
  namespace: bifract
spec:
  replicas: 1
  selector:
    matchLabels:
      app: litellm
  template:
    metadata:
      labels:
        app: litellm
      annotations:
        # Rolls the pod when config.yaml changes. The file is mounted with
        # subPath, which kubelet never updates in place.
        bifract.io/config-hash: "{{.LiteLLMConfigHash}}"
    spec:
      automountServiceAccountToken: false
      # Third-party image, hardened to the same bar as the Bifract workloads.
      # It ships USER root, so the identity is set here rather than inherited.
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: litellm
          image: ghcr.io/berriai/litellm:v1.100.1@sha256:a3715fa7ad8387941ab697259bd2881d68931657247a41984f90fae6d11c62bf
          args: ["--config", "/app/config.yaml", "--port", "8000"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          ports:
            - containerPort: 8000
          env:
            - name: LITELLM_API_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: LITELLM_API_KEY
                  optional: true
            - name: LITELLM_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: LITELLM_MASTER_KEY
          volumeMounts:
            - name: config
              mountPath: /app/config.yaml
              subPath: config.yaml
              readOnly: true
            # The only path litellm writes under readOnlyRootFilesystem.
            - name: tmp
              mountPath: /tmp
          readinessProbe:
            httpGet:
              path: /health/readiness
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /health/liveliness
              port: 8000
            initialDelaySeconds: 20
            periodSeconds: 30
          resources:
            requests:
              cpu: {{.LiteLLMRes.CPURequest}}
              memory: {{.LiteLLMRes.MemRequest}}
            limits:
              cpu: "{{.LiteLLMRes.CPULimit}}"
              memory: {{.LiteLLMRes.MemLimit}}
      volumes:
        - name: config
          configMap:
            name: litellm-config
        # Disk-backed on purpose: a Memory-medium emptyDir counts against the
        # container's memory limit, which is 1Gi on most profiles.
        - name: tmp
          emptyDir:
            sizeLimit: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: litellm
  namespace: bifract
spec:
  ports:
    - port: 8000
      targetPort: 8000
  selector:
    app: litellm
