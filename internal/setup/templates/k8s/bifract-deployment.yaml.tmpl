apiVersion: apps/v1
kind: Deployment
metadata:
  name: bifract
  namespace: bifract
spec:
  # The maxmind PVC below is ReadWriteOnce by default, which a cloud block-storage class
  # can only attach to one node. Two consequences, both of which surface as a stuck pod on
  # a first install:
  #   - replicas must stay at 1 unless MaxmindPVCAccessMode is set to ReadWriteMany (an
  #     RWX class such as azurefile-csi, EFS, or NFS). With RWO, a second replica lands on
  #     another node and sits in ContainerCreating with a Multi-Attach error forever.
  #   - the strategy must be Recreate. RollingUpdate starts the new pod before terminating
  #     the old one, so the new pod waits on a volume the old pod still holds and the
  #     rollout deadlocks on every upgrade.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: bifract
  template:
    metadata:
      labels:
        app: bifract
    spec:
{{- if .ImagePullSecrets}}
      imagePullSecrets:
{{- range .ImagePullSecrets}}
        - name: {{.}}
{{- end}}
{{- end}}
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app: bifract
                topologyKey: kubernetes.io/hostname
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: bifract
          image: ghcr.io/zanegittins/bifract:{{.ImageTag}}
          securityContext:
            runAsUser: 65534
            runAsGroup: 65534
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          ports:
            - containerPort: 8080
          env:
            - name: POSTGRES_HOST
              value: postgres
            - name: POSTGRES_PORT
              value: "5432"
            - name: POSTGRES_DB
              value: bifract
            - name: POSTGRES_USER
              value: bifract
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: POSTGRES_PASSWORD
            # Least-privilege ingest PG role password: the app provisions bifract_ingest.
            - name: BIFRACT_INGEST_POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: INGEST_POSTGRES_PASSWORD
{{- range .CHEnvApp}}
            - name: {{.Name}}
              value: "{{.Value}}"
{{- end}}
            - name: CLICKHOUSE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: CLICKHOUSE_PASSWORD
            # Least-privilege ingest CH user password: the app (admin) provisions the
            # bifract_ingest user at startup so the ingest tier gets INSERT-only access.
            - name: BIFRACT_INGEST_CLICKHOUSE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: INGEST_CLICKHOUSE_PASSWORD
            - name: BIFRACT_PORT
              value: "8080"
            - name: BIFRACT_SECURE_COOKIES
              value: "true"
            - name: BIFRACT_DOMAIN
              value: "{{.Domain}}"
            - name: BIFRACT_BASE_URL
              value: "https://{{.Domain}}"
            - name: BIFRACT_PASSWORD_PEPPER
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: PASSWORD_PEPPER
            - name: BIFRACT_FEED_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: FEED_ENCRYPTION_KEY
            - name: BIFRACT_BACKUP_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: BACKUP_ENCRYPTION_KEY
            - name: BIFRACT_ADMIN_PASSWORD_HASH
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ADMIN_PASSWORD_HASH
            - name: BIFRACT_CORS_ORIGINS
              valueFrom:
                configMapKeyRef:
                  name: bifract-config
                  key: CORS_ORIGINS
            - name: LITELLM_URL
              value: http://litellm:8000
            - name: LITELLM_MASTER_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: LITELLM_MASTER_KEY
            # Query limits
            - name: BIFRACT_MAX_QUERY_ROWS
              value: "250"
            # Ingestion queue tuning
            - name: BIFRACT_INGEST_QUEUE_SIZE
              value: "{{.IngestQueueSize}}"
            - name: BIFRACT_INGEST_WORKERS
              value: "{{.IngestWorkers}}"
            # Dashboard executor tuning
            - name: BIFRACT_DASHBOARD_WORKERS
              value: "{{.DashboardWorkers}}"
            - name: BIFRACT_DASHBOARD_MIN_REFRESH
              value: "{{.DashboardMinRefresh}}"
            - name: BIFRACT_DASHBOARD_TICK
              value: "{{.DashboardTick}}"
            # Archive: the spool + tee live in the bifract-ingest tier (the primary
            # log producer); the app tier is not a spool writer (provisioned/usage
            # come from the ingest tier's status published to Postgres).
            #
            # The app tier DOES host the recall + restore job queues. Both only
            # resolve Iceberg metadata and hand the scan to ClickHouse, so they cost
            # a few idle goroutines rather than a workload of their own, and running
            # them in the always-on tier means scaling ingest down cannot leave
            # archive jobs stuck at 'pending'. That is why the object-store settings
            # below are live config here and not display hints. Concurrency is capped
            # globally at claim time, so replicas do not multiply archive scans.
            - name: BIFRACT_ARCHIVE_ENABLED
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ENABLED
                  optional: true
            - name: BIFRACT_ARCHIVE_BACKEND
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_BACKEND
                  optional: true
            - name: BIFRACT_ARCHIVE_PREFIX
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_PREFIX
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_ENDPOINT
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_BUCKET
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_BUCKET
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_REGION
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_REGION
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_ACCESS_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_SECRET_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_ACCOUNT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_ACCOUNT
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_CONTAINER
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_CONTAINER
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_ENDPOINT
                  optional: true
            # Concurrent archive scans allowed against ClickHouse, per queue.
            - name: BIFRACT_ARCHIVE_JOB_CONCURRENCY
              value: "{{.ArchiveJobConcurrency}}"
            # S3 (for PostgreSQL backups)
            - name: BIFRACT_S3_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: S3_ENDPOINT
                  optional: true
            - name: BIFRACT_S3_BUCKET
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: S3_BUCKET
                  optional: true
            - name: BIFRACT_S3_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: S3_ACCESS_KEY
                  optional: true
            - name: BIFRACT_S3_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: S3_SECRET_KEY
                  optional: true
            - name: BIFRACT_S3_REGION
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: S3_REGION
                  optional: true
            # MaxMind GeoIP
            - name: MAXMIND_LICENSE_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: MAXMIND_LICENSE_KEY
                  optional: true
            - name: MAXMIND_ACCOUNT_ID
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: MAXMIND_ACCOUNT_ID
                  optional: true
            - name: MAXMIND_EDITION_IDS
              value: "GeoLite2-City-CSV,GeoLite2-ASN-CSV"
            # OIDC / SSO
            - name: BIFRACT_OIDC_ISSUER_URL
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_ISSUER_URL
                  optional: true
            - name: BIFRACT_OIDC_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_CLIENT_ID
                  optional: true
            - name: BIFRACT_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_CLIENT_SECRET
                  optional: true
            - name: BIFRACT_OIDC_REDIRECT_URL
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_REDIRECT_URL
                  optional: true
            - name: BIFRACT_OIDC_SCOPES
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_SCOPES
                  optional: true
            - name: BIFRACT_OIDC_DEFAULT_ROLE
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_DEFAULT_ROLE
                  optional: true
            - name: BIFRACT_OIDC_ALLOWED_DOMAINS
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_ALLOWED_DOMAINS
                  optional: true
            - name: BIFRACT_OIDC_BUTTON_TEXT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: OIDC_BUTTON_TEXT
                  optional: true
{{- if .MTLSEnabled}}
            - name: BIFRACT_CLIENT_CA_DIR
              value: /client-ca
{{- end}}
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 20
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: maxmind-data
              mountPath: /data/maxmind
{{- if .MTLSEnabled}}
            - name: client-ca
              mountPath: /client-ca
              readOnly: true
{{- end}}
          resources:
            requests:
              cpu: {{.BifractRes.CPURequest}}
              memory: {{.BifractRes.MemRequest}}
            limits:
              cpu: "{{.BifractRes.CPULimit}}"
              memory: {{.BifractRes.MemLimit}}
      volumes:
        - name: tmp
          emptyDir: {}
        - name: maxmind-data
          persistentVolumeClaim:
            claimName: bifract-maxmind
{{- if .MTLSEnabled}}
        - name: client-ca
          secret:
            secretName: bifract-mtls-ca
{{- end}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: bifract-maxmind
  namespace: bifract
spec:
  accessModes:
    - {{if .MaxmindPVCAccessMode}}{{.MaxmindPVCAccessMode}}{{else}}ReadWriteOnce{{end}}
{{- if .MaxmindPVCStorageClass}}
  storageClassName: {{.MaxmindPVCStorageClass}}
{{- end}}
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: bifract
  namespace: bifract
spec:
  ports:
    - port: 8080
      targetPort: 8080
  selector:
    app: bifract
