apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: bifract-ingest
  namespace: bifract
spec:
  # A StatefulSet (not a Deployment) so each ingest pod gets its own stable,
  # durable spool PVC via volumeClaimTemplates. The archive spool is the
  # fail-closed durability boundary (fsync before ack); on an emptyDir it was lost
  # on every rolling update or eviction, silently and undetectably punching a hole
  # in the archive. serviceName points at the headless Service below; routing
  # still goes through the ClusterIP Service.
  serviceName: bifract-ingest-headless
  # Parallel management: this tier is load-balanced and stateless apart from its
  # own spool, so pods start/scale together like a Deployment rather than waiting
  # for ordinal ordering.
  podManagementPolicy: Parallel
  # Independently scalable data-plane tier. Scale to 0 to pause ingest during
  # ClickHouse merge recovery while the app/UI tier keeps serving. Each pod's spool
  # PVC persists across a scale-to-0/back, so buffered data survives the pause.
  replicas: {{.IngestReplicas}}
  selector:
    matchLabels:
      app: bifract-ingest
  template:
    metadata:
      labels:
        app: bifract-ingest
    spec:
{{- if .ImagePullSecrets}}
      imagePullSecrets:
{{- range .ImagePullSecrets}}
        - name: {{.}}
{{- end}}
{{- end}}
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app: bifract-ingest
                topologyKey: kubernetes.io/hostname
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
        # The spool PVC is CSI-provisioned and root-owned by default; fsGroup makes
        # it group-writable so the non-root (65534) ingest/archiver containers can
        # write the spool under readOnlyRootFilesystem.
        fsGroup: 65534
      containers:
        # Ingest data plane: `/bifract-server ingest`. No control plane, no UI.
        - name: bifract-ingest
          image: ghcr.io/zanegittins/bifract:{{.ImageTag}}
          args: ["ingest"]
          securityContext:
            runAsUser: 65534
            runAsGroup: 65534
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          ports:
            - containerPort: 8080
          env:
            - name: POSTGRES_HOST
              value: postgres
            - name: POSTGRES_PORT
              value: "5432"
            - name: POSTGRES_DB
              value: bifract
            # Least-privilege ingest PG role (curated grants; no users/sessions/api_keys).
            - name: POSTGRES_USER
              value: bifract_ingest
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: INGEST_POSTGRES_PASSWORD
            # Least-privilege ingest identity (INSERT-only on logs; cannot read log
            # data). Provisioned by the app tier at startup.
{{- range .CHEnvIngest}}
            - name: {{.Name}}
              value: "{{.Value}}"
{{- end}}
            - name: CLICKHOUSE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: INGEST_CLICKHOUSE_PASSWORD
            - name: BIFRACT_PORT
              value: "8080"
            # Ingestion queue tuning
            - name: BIFRACT_INGEST_QUEUE_SIZE
              value: "{{.IngestQueueSize}}"
            - name: BIFRACT_INGEST_WORKERS
              value: "{{.IngestWorkers}}"
            # Server-side insert coalescing: batches many small inserts into fewer,
            # larger parts, which caps the per-minute part-creation rate on logs and
            # its per-insert materialized views (logs_histogram in particular, whose
            # tiny per-block parts otherwise outpace merges under bursty ingest and
            # trip TOO_MANY_PARTS). wait_for_async_insert=1 (set in code) keeps the
            # client blocked until flush, so a successful insert still means durably
            # written and ingest acks/backpressure stay meaningful. Default-on for the
            # multi-shard cluster path; docker (single-node, no Distributed engine)
            # leaves it opt-in.
            - name: BIFRACT_ASYNC_INSERT
              value: "1"
            # Archive tee (dormant-but-present): the ingest tier is the sole spool
            # writer. Off = zero overhead; enable at runtime (admin UI or the secret).
            - name: BIFRACT_ARCHIVE_ENABLED
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ENABLED
                  optional: true
            - name: BIFRACT_ARCHIVE_SPOOL_PATH
              value: /var/lib/bifract/spool
            # Spool capacity watermark: ingest backpressures (429) at 90% of this.
            # Always ~80% of the spool PVC size below, computed at render time --
            # there is no secret override for this one. Resize the PVC (which
            # upgrades now preserve, see spoolPVCSizeGB in upgrade_k8s.go) rather
            # than trying to set this independently of it.
            - name: BIFRACT_ARCHIVE_SPOOL_MAX_BYTES
              value: "{{.SpoolMaxBytes}}"
            - name: BIFRACT_ARCHIVE_ROLL_BYTES
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ROLL_BYTES
                  optional: true
            - name: BIFRACT_ARCHIVE_BACKEND
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_BACKEND
                  optional: true
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 20
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: spool
              mountPath: /var/lib/bifract/spool
          resources:
            requests:
              cpu: {{.BifractRes.CPURequest}}
              memory: {{.BifractRes.MemRequest}}
            limits:
              cpu: "{{.BifractRes.CPULimit}}"
              memory: {{.BifractRes.MemLimit}}
        # Iceberg archive sidecar (dormant-but-present). Co-located with the ingest
        # tier since that is where the bulk of logs are spooled. Shares the pod-local
        # spool with the ingest container. Idles until archiving is enabled. Use an
        # object-storage backend (s3/minio/azure) in k8s; the disk backend is
        # pod-local (single-pod/testing only).
        - name: bifract-archiver
          image: ghcr.io/zanegittins/bifract:{{.ImageTag}}
          command: ["/bifract-archiver", "run"]
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          env:
            - name: POSTGRES_HOST
              value: "postgres"
            - name: POSTGRES_PORT
              value: "5432"
            - name: POSTGRES_DB
              value: "bifract"
            - name: POSTGRES_USER
              value: "bifract"
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: POSTGRES_PASSWORD
            # No ClickHouse env: this sidecar only drains the spool into Iceberg.
            # Restore (the one archive path that writes back into logs) moved to the
            # archive-workers container, so the ingest tier no longer holds
            # ClickHouse credentials at all.
            - name: BIFRACT_ARCHIVE_SPOOL_PATH
              value: /var/lib/bifract/spool
            - name: BIFRACT_ARCHIVE_DISK_PATH
              value: /var/lib/bifract/archive
            - name: BIFRACT_ARCHIVE_ENABLED
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ENABLED
                  optional: true
            - name: BIFRACT_ARCHIVE_BACKEND
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_BACKEND
                  optional: true
            - name: BIFRACT_ARCHIVE_PREFIX
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_PREFIX
                  optional: true
            - name: BIFRACT_ARCHIVE_ROLL_BYTES
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ROLL_BYTES
                  optional: true
            - name: BIFRACT_ARCHIVE_ROLL_INTERVAL
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_ROLL_INTERVAL
                  optional: true
            # Total in-memory buffer cap across all fractals. ARCHIVE_ROLL_BYTES
            # is per-fractal, so this is what bounds the sidecar's heap when many
            # fractals ingest at once. Raise it (with the memory limit below) to
            # get larger Parquet files on a many-fractal deployment.
            - name: BIFRACT_ARCHIVE_MAX_PENDING_BYTES
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_MAX_PENDING_BYTES
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_ENDPOINT
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_BUCKET
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_BUCKET
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_REGION
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_REGION
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_ACCESS_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_S3_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_S3_SECRET_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_ACCOUNT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_ACCOUNT
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_KEY
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_KEY
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_CONTAINER
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_CONTAINER
                  optional: true
            - name: BIFRACT_ARCHIVE_AZURE_ENDPOINT
              valueFrom:
                secretKeyRef:
                  name: bifract-secrets
                  key: ARCHIVE_AZURE_ENDPOINT
                  optional: true
          volumeMounts:
            - name: spool
              mountPath: /var/lib/bifract/spool
            - name: archiver-tmp
              mountPath: /tmp
            - name: archive-data
              mountPath: /var/lib/bifract/archive
          resources:
            requests:
              cpu: {{.ArchiverRes.CPURequest}}
              memory: {{.ArchiverRes.MemRequest}}
            limits:
              cpu: "{{.ArchiverRes.CPULimit}}"
              memory: {{.ArchiverRes.MemLimit}}
      volumes:
        - name: tmp
          emptyDir: {}
        - name: archiver-tmp
          emptyDir: {}
        # Disk-backend local Iceberg path. Only used by the (single-pod/testing)
        # disk backend; production uses S3/Azure, where this is unused. Ephemeral by
        # design -- unlike the spool, it is not a durability boundary.
        - name: archive-data
          emptyDir: {}
  # Per-pod durable spool. Shared within the pod by the ingest server (writer) and
  # the archiver sidecar (reader). Survives pod restarts, rolling updates, and
  # evictions, so un-archived batches are never dropped. ReadWriteOnce: exactly one
  # pod (its own) mounts each claim, matching the spool's single-writer contract.
  volumeClaimTemplates:
    - metadata:
        name: spool
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: {{.SpoolPVCSize}}
---
# ClusterIP Service: the load-balanced ingest endpoint Caddy routes to.
apiVersion: v1
kind: Service
metadata:
  name: bifract-ingest
  namespace: bifract
spec:
  ports:
    - port: 8080
      targetPort: 8080
  selector:
    app: bifract-ingest
---
# Headless Service backing the StatefulSet's stable per-pod DNS identity. Not used
# for routing (the ClusterIP Service above does that); required by StatefulSet.
apiVersion: v1
kind: Service
metadata:
  name: bifract-ingest-headless
  namespace: bifract
spec:
  clusterIP: None
  ports:
    - port: 8080
      targetPort: 8080
  selector:
    app: bifract-ingest
