services:
  caddy:
    image: caddy:2-alpine
    container_name: bifract-caddy
    ports:
      - "80:80"
      - "443:443"
      - "8443:8443"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile
      - ./caddy/ship-logs.sh:/usr/local/bin/ship-logs.sh
      - ./caddy/entrypoint.sh:/usr/local/bin/entrypoint.sh
      - caddy-data:/data
      - caddy-config:/config
{{- if or (eq .SSLMode "self-signed") (eq .SSLMode "custom")}}
      - ./caddy/certs:/etc/caddy/certs:ro
{{- end}}
{{- if eq .IPAccess "mtls-app"}}
      - ./caddy/client-ca:/etc/caddy/client-ca:ro
{{- end}}
    environment:
      BIFRACT_DOMAIN: ${BIFRACT_DOMAIN:-localhost}
    entrypoint: ["/usr/local/bin/entrypoint.sh"]
    depends_on:
      - bifract
    networks:
      - bifract-network
    restart: unless-stopped

  postgres:
    image: postgres:16
    container_name: bifract-postgres
    environment:
      POSTGRES_DB: bifract
      POSTGRES_USER: bifract
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./db/init-postgres.sql:/docker-entrypoint-initdb.d/init.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U bifract"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - bifract-network
    restart: unless-stopped

  clickhouse:
    image: clickhouse/clickhouse-server:26.6.2.81-alpine
    container_name: bifract-clickhouse
    volumes:
      - clickhouse-data:/var/lib/clickhouse
      - ./db/init-clickhouse.sql:/docker-entrypoint-initdb.d/init.sql:ro
    environment:
      CLICKHOUSE_DB: logs
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    healthcheck:
      test: ["CMD", "clickhouse-client", "--user", "default", "--password", "${CLICKHOUSE_PASSWORD}", "--query", "SELECT 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - bifract-network
    restart: unless-stopped

  litellm:
    image: ghcr.io/berriai/litellm:main-v1.81.14-stable
    container_name: bifract-litellm
    volumes:
      - ./litellm-config.yaml:/app/config.yaml
    environment:
      LITELLM_API_KEY: ${LITELLM_API_KEY:-}
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
    command: ["--config", "/app/config.yaml", "--port", "8000"]
    networks:
      - bifract-network
    restart: unless-stopped

  bifract:
    image: ghcr.io/zanegittins/bifract:${BIFRACT_VERSION:-latest}
    container_name: bifract-app
    # mem_limit gives automemlimit a real cgroup ceiling to derive GOMEMLIMIT from,
    # so the GC tightens as the process approaches the limit instead of the container
    # being OOM-killed at it. CPU is deliberately left uncapped: automaxprocs would
    # shrink GOMAXPROCS to match and slow query serving.
    mem_limit: ${BIFRACT_MEM_LIMIT:-4g}
    environment:
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: 9000
      CLICKHOUSE_DB: logs
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      # Least-privilege ingest identities: the app (admin) provisions them at startup so
      # the ingest tier gets INSERT-only CH access + a curated PG role (cannot read logs
      # or auth data).
      BIFRACT_INGEST_CLICKHOUSE_PASSWORD: ${BIFRACT_INGEST_CLICKHOUSE_PASSWORD}
      BIFRACT_INGEST_POSTGRES_PASSWORD: ${BIFRACT_INGEST_POSTGRES_PASSWORD}
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: bifract
      POSTGRES_USER: bifract
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      BIFRACT_PORT: 8080
      BIFRACT_MAX_QUERY_ROWS: 250
      # Dashboard executor tuning (optional; defaults apply when unset in .env)
      BIFRACT_DASHBOARD_WORKERS: ${BIFRACT_DASHBOARD_WORKERS:-4}
      BIFRACT_DASHBOARD_MIN_REFRESH: ${BIFRACT_DASHBOARD_MIN_REFRESH:-10}
      BIFRACT_DASHBOARD_TICK: ${BIFRACT_DASHBOARD_TICK:-5}
      BIFRACT_SECURE_COOKIES: ${BIFRACT_SECURE_COOKIES:-false}
      BIFRACT_CORS_ORIGINS: ${BIFRACT_CORS_ORIGINS:-https://localhost}
      BIFRACT_DOMAIN: ${BIFRACT_DOMAIN:-localhost}
      BIFRACT_PASSWORD_PEPPER: ${BIFRACT_PASSWORD_PEPPER}
      BIFRACT_FEED_ENCRYPTION_KEY: ${BIFRACT_FEED_ENCRYPTION_KEY}
      LITELLM_URL: http://litellm:8000
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      BIFRACT_BASE_URL: ${BIFRACT_BASE_URL:-}
      BIFRACT_OIDC_ISSUER_URL: ${BIFRACT_OIDC_ISSUER_URL:-}
      BIFRACT_OIDC_CLIENT_ID: ${BIFRACT_OIDC_CLIENT_ID:-}
      BIFRACT_OIDC_CLIENT_SECRET: ${BIFRACT_OIDC_CLIENT_SECRET:-}
      BIFRACT_OIDC_REDIRECT_URL: ${BIFRACT_OIDC_REDIRECT_URL:-}
      BIFRACT_OIDC_SCOPES: ${BIFRACT_OIDC_SCOPES:-openid,profile,email}
      BIFRACT_OIDC_DEFAULT_ROLE: ${BIFRACT_OIDC_DEFAULT_ROLE:-user}
      BIFRACT_OIDC_ALLOWED_DOMAINS: ${BIFRACT_OIDC_ALLOWED_DOMAINS:-}
      BIFRACT_OIDC_BUTTON_TEXT: ${BIFRACT_OIDC_BUTTON_TEXT:-Sign in with SSO}
      BIFRACT_BACKUP_ENCRYPTION_KEY: ${BIFRACT_BACKUP_ENCRYPTION_KEY:-}
      BIFRACT_S3_ENDPOINT: ${BIFRACT_S3_ENDPOINT:-}
      BIFRACT_S3_BUCKET: ${BIFRACT_S3_BUCKET:-}
      BIFRACT_S3_ACCESS_KEY: ${BIFRACT_S3_ACCESS_KEY:-}
      BIFRACT_S3_SECRET_KEY: ${BIFRACT_S3_SECRET_KEY:-}
      BIFRACT_S3_REGION: ${BIFRACT_S3_REGION:-}
      # Archive: the spool + tee live in the bifract-ingest tier (the primary log
      # producer); the app tier is not a spool writer. Display-only hints for the
      # admin UI (enable state from Postgres; provisioned/usage from the ingest tier).
      BIFRACT_ARCHIVE_ENABLED: ${BIFRACT_ARCHIVE_ENABLED:-false}
      BIFRACT_ARCHIVE_BACKEND: ${BIFRACT_ARCHIVE_BACKEND:-disk}
      MAXMIND_LICENSE_KEY: ${MAXMIND_LICENSE_KEY:-}
      MAXMIND_ACCOUNT_ID: ${MAXMIND_ACCOUNT_ID:-}
      MAXMIND_EDITION_IDS: ${MAXMIND_EDITION_IDS:-GeoLite2-City-CSV,GeoLite2-ASN-CSV}
{{- if eq .IPAccess "mtls-app"}}
      BIFRACT_CLIENT_CA_DIR: /client-ca
{{- end}}
    volumes:
      - bifract-maxmind:/data/maxmind
{{- if eq .IPAccess "mtls-app"}}
      - ./caddy/client-ca:/client-ca:ro
{{- end}}
    healthcheck:
      test: ["CMD", "/bifract-server", "-healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
    networks:
      - bifract-network
    restart: unless-stopped

  # Ingest data-plane tier. Same image as bifract, run in ingest mode
  # (`/bifract-server ingest`, matching the archiver's command-arg dispatch). Scales
  # independently of the app/UI tier -- down to 0 to pause ingest during ClickHouse
  # merge recovery while the app keeps serving. Caddy routes external ingest here;
  # the app tier keeps its own queue only for internal/audit writes. This tier is the
  # sole archive-spool producer.
  bifract-ingest:
    image: ghcr.io/zanegittins/bifract:${BIFRACT_VERSION:-latest}
    container_name: bifract-ingest
    command: ["ingest"]
    # Sized above the ingest queue's worst case (BIFRACT_INGEST_QUEUE_SIZE x 5,000
    # logs, ~1GB) plus the archive spool, so GOMEMLIMIT lands above normal working
    # set and the GC only tightens under genuine pressure.
    mem_limit: ${BIFRACT_INGEST_MEM_LIMIT:-4g}
    environment:
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: 9000
      CLICKHOUSE_DB: logs
      # Least-privilege ingest identities (INSERT-only on logs; curated PG grants).
      CLICKHOUSE_USER: bifract_ingest
      CLICKHOUSE_PASSWORD: ${BIFRACT_INGEST_CLICKHOUSE_PASSWORD}
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: bifract
      POSTGRES_USER: bifract_ingest
      POSTGRES_PASSWORD: ${BIFRACT_INGEST_POSTGRES_PASSWORD}
      BIFRACT_PORT: 8080
      BIFRACT_INGEST_QUEUE_SIZE: ${BIFRACT_INGEST_QUEUE_SIZE:-100}
      BIFRACT_INGEST_WORKERS: ${BIFRACT_INGEST_WORKERS:-4}
      BIFRACT_INGEST_RATE_LIMIT: ${BIFRACT_INGEST_RATE_LIMIT:-10000}
      # Archive tee (dormant-but-present): the ingest tier is the sole spool writer.
      BIFRACT_ARCHIVE_ENABLED: ${BIFRACT_ARCHIVE_ENABLED:-false}
      BIFRACT_ARCHIVE_SPOOL_PATH: /var/lib/bifract/spool
      BIFRACT_ARCHIVE_SPOOL_MAX_BYTES: ${BIFRACT_ARCHIVE_SPOOL_MAX_BYTES:-10737418240}
      BIFRACT_ARCHIVE_ROLL_BYTES: ${BIFRACT_ARCHIVE_ROLL_BYTES:-134217728}
      BIFRACT_ARCHIVE_MAX_PENDING_BYTES: ${BIFRACT_ARCHIVE_MAX_PENDING_BYTES:-1073741824}
      BIFRACT_ARCHIVE_BACKEND: ${BIFRACT_ARCHIVE_BACKEND:-disk}
    volumes:
      - bifract-spool:/var/lib/bifract/spool
    healthcheck:
      test: ["CMD", "/bifract-server", "-healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      bifract:
        condition: service_healthy
    networks:
      - bifract-network
    restart: unless-stopped

  # Iceberg archive sidecar (dormant-but-present). Same image, archiver command.
  # Drains the shared spool into per-fractal Iceberg tables on object storage.
  # Idles until archiving is enabled (admin UI or BIFRACT_ARCHIVE_ENABLED).
  bifract-archiver:
    image: ghcr.io/zanegittins/bifract:${BIFRACT_VERSION:-latest}
    container_name: bifract-archiver
    # Override the image ENTRYPOINT (/bifract-server); in compose `command` is
    # appended to the entrypoint, so the entrypoint itself must be replaced.
    entrypoint: ["/bifract-archiver"]
    command: ["run"]
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: bifract
      POSTGRES_USER: bifract
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-bifract}
      # ClickHouse connection: the restore/reconcile worker writes archived rows
      # back into the logs table, so the archiver needs the same CH access as the
      # server.
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: 9000
      CLICKHOUSE_DB: logs
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      BIFRACT_ARCHIVE_ENABLED: ${BIFRACT_ARCHIVE_ENABLED:-false}
      BIFRACT_ARCHIVE_BACKEND: ${BIFRACT_ARCHIVE_BACKEND:-disk}
      BIFRACT_ARCHIVE_DISK_PATH: /var/lib/bifract/archive
      BIFRACT_ARCHIVE_PREFIX: ${BIFRACT_ARCHIVE_PREFIX:-}
      BIFRACT_ARCHIVE_S3_ENDPOINT: ${BIFRACT_ARCHIVE_S3_ENDPOINT:-}
      BIFRACT_ARCHIVE_S3_BUCKET: ${BIFRACT_ARCHIVE_S3_BUCKET:-}
      BIFRACT_ARCHIVE_S3_REGION: ${BIFRACT_ARCHIVE_S3_REGION:-us-east-1}
      BIFRACT_ARCHIVE_S3_ACCESS_KEY: ${BIFRACT_ARCHIVE_S3_ACCESS_KEY:-}
      BIFRACT_ARCHIVE_S3_SECRET_KEY: ${BIFRACT_ARCHIVE_S3_SECRET_KEY:-}
      BIFRACT_ARCHIVE_AZURE_ACCOUNT: ${BIFRACT_ARCHIVE_AZURE_ACCOUNT:-}
      BIFRACT_ARCHIVE_AZURE_KEY: ${BIFRACT_ARCHIVE_AZURE_KEY:-}
      BIFRACT_ARCHIVE_AZURE_CONTAINER: ${BIFRACT_ARCHIVE_AZURE_CONTAINER:-}
      BIFRACT_ARCHIVE_AZURE_ENDPOINT: ${BIFRACT_ARCHIVE_AZURE_ENDPOINT:-}
      BIFRACT_ARCHIVE_SPOOL_PATH: /var/lib/bifract/spool
      BIFRACT_ARCHIVE_ROLL_BYTES: ${BIFRACT_ARCHIVE_ROLL_BYTES:-134217728}
      BIFRACT_ARCHIVE_ROLL_INTERVAL: ${BIFRACT_ARCHIVE_ROLL_INTERVAL:-30m}
      BIFRACT_ARCHIVE_MAX_PENDING_BYTES: ${BIFRACT_ARCHIVE_MAX_PENDING_BYTES:-1073741824}
    volumes:
      - bifract-spool:/var/lib/bifract/spool
      - bifract-archive:/var/lib/bifract/archive
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - bifract-network
    restart: unless-stopped

  # Iceberg maintenance (compaction + snapshot expiry): the always-on maintenance
  # service. A dedicated, resource-capped container running maintain-loop, kept
  # SEPARATE from the drain loop above: compaction is the memory-heavy step, and
  # isolating it here means a spike OOMs only this (mostly idle) container while
  # ingest keeps flowing. It services scheduled passes
  # (BIFRACT_ARCHIVE_MAINTAIN_INTERVAL, default 1h) plus admin "Run now" requests
  # picked up from Postgres, and is a singleton via a Postgres advisory lock;
  # disable by scaling this service to 0. In k8s the same maintain-loop runs as a
  # replicas:1 Deployment. mem_limit/cpus are set so automemlimit/automaxprocs
  # derive GOMEMLIMIT/GOMAXPROCS from a real cgroup ceiling rather than the host's
  # totals, bounding compaction's footprint.
  bifract-archiver-maintain:
    image: ghcr.io/zanegittins/bifract:${BIFRACT_VERSION:-latest}
    container_name: bifract-archiver-maintain
    entrypoint: ["/bifract-archiver"]
    command: ["maintain-loop"]
    mem_limit: ${BIFRACT_ARCHIVE_MAINTAIN_MEM_LIMIT:-4g}
    cpus: ${BIFRACT_ARCHIVE_MAINTAIN_CPUS:-2}
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: bifract
      POSTGRES_USER: bifract
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-bifract}
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: 9000
      CLICKHOUSE_DB: logs
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      BIFRACT_ARCHIVE_MAINTAIN_INTERVAL: ${BIFRACT_ARCHIVE_MAINTAIN_INTERVAL:-1h}
      BIFRACT_ARCHIVE_ENABLED: ${BIFRACT_ARCHIVE_ENABLED:-false}
      BIFRACT_ARCHIVE_BACKEND: ${BIFRACT_ARCHIVE_BACKEND:-disk}
      BIFRACT_ARCHIVE_DISK_PATH: /var/lib/bifract/archive
      BIFRACT_ARCHIVE_PREFIX: ${BIFRACT_ARCHIVE_PREFIX:-}
      BIFRACT_ARCHIVE_S3_ENDPOINT: ${BIFRACT_ARCHIVE_S3_ENDPOINT:-}
      BIFRACT_ARCHIVE_S3_BUCKET: ${BIFRACT_ARCHIVE_S3_BUCKET:-}
      BIFRACT_ARCHIVE_S3_REGION: ${BIFRACT_ARCHIVE_S3_REGION:-us-east-1}
      BIFRACT_ARCHIVE_S3_ACCESS_KEY: ${BIFRACT_ARCHIVE_S3_ACCESS_KEY:-}
      BIFRACT_ARCHIVE_S3_SECRET_KEY: ${BIFRACT_ARCHIVE_S3_SECRET_KEY:-}
      BIFRACT_ARCHIVE_AZURE_ACCOUNT: ${BIFRACT_ARCHIVE_AZURE_ACCOUNT:-}
      BIFRACT_ARCHIVE_AZURE_KEY: ${BIFRACT_ARCHIVE_AZURE_KEY:-}
      BIFRACT_ARCHIVE_AZURE_CONTAINER: ${BIFRACT_ARCHIVE_AZURE_CONTAINER:-}
      BIFRACT_ARCHIVE_AZURE_ENDPOINT: ${BIFRACT_ARCHIVE_AZURE_ENDPOINT:-}
    volumes:
      - bifract-archive:/var/lib/bifract/archive
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - bifract-network
    restart: unless-stopped

volumes:
  postgres-data:
  clickhouse-data:
  caddy-data:
  caddy-config:
  bifract-maxmind:
  bifract-spool:
  bifract-archive:

networks:
  bifract-network:
    driver: bridge
